{
  "include": [
    "src",
    "tests",
    "analyze.py"
  ],
  "exclude": [
    "**/__pycache__",
    ".venv"
  ],
  "extraPaths": [
    "src"
  ],
  "pythonVersion": "3.12",
  "pythonPlatform": "Darwin",
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "venvPath": ".",
  "venv": ".venv"
}